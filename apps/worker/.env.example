# ============================================================================
# Wrapd · Python worker · variables de entorno
# Copia este fichero a .env y rellénalo. NUNCA commitees .env.
# ============================================================================

# --- Postgres (Supabase) -----------------------------------------------------
# Project Settings → Database → Connection string → URI
POSTGRES_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Spotify -----------------------------------------------------------------
# Mismas creds que el frontend
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
